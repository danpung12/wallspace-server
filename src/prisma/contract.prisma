  model Reviews {
    id         Uuid               @id(map: "reviews_pkey") @default(sql`gen_random_uuid()`)
    userId     Uuid?              @map("user_id")
    locationId Uuid?              @map("location_id")
    bookingId  Uuid?              @map("booking_id")
    rating     Int?
    comment    String?
    createdAt  TimestamptzString? @default(now()) @map("created_at")
    updatedAt  TimestamptzString? @default(now()) @map("updated_at")
    booking    Bookings?          @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "reviews_booking_id_fkey", index: false)
    location   Locations?         @relation(fields: [locationId], references: [id], onDelete: Cascade, map: "reviews_location_id_fkey", index: false)
    user       Profiles?          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "reviews_user_id_fkey", index: false)

    @@check(expression: sql`((rating >= 1) AND (rating <= 5))`, map: "reviews_rating_check")
    @@rls
    @@map("reviews")
  }

  model UserOnlineStatus {
    userId    Uuid               @id(map: "user_online_status_pkey") @map("user_id")
    isOnline  Boolean?           @default(false) @map("is_online")
    lastSeen  TimestamptzString? @default(sql`timezone('utc'::text, now())`) @map("last_seen")
    createdAt TimestamptzString  @default(sql`timezone('utc'::text, now())`) @map("created_at")
    updatedAt TimestamptzString  @default(sql`timezone('utc'::text, now())`) @map("updated_at")
    user      Profiles           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_online_status_user_id_fkey")

    @@index([isOnline], map: "idx_user_online_status_online")
    @@rls
    @@map("user_online_status")
  }

  // WARNING: Foreign key "userId" -> "auth.users" exists in the database, but its target schema is outside the introspected scope, so no relation field was generated. If the target schema is described by an extension pack, add it to extensions and re-run infer.
  model UserPushTokens {
    id         Uuid               @id(map: "user_push_tokens_pkey") @default(sql`gen_random_uuid()`)
    userId     Uuid               @map("user_id")
    pushToken  String             @map("push_token")
    deviceType String?            @map("device_type")
    deviceId   String?            @map("device_id")
    appVersion String?            @map("app_version")
    isActive   Boolean?           @default(true) @map("is_active")
    createdAt  TimestamptzString? @default(now()) @map("created_at")
    updatedAt  TimestamptzString? @default(now()) @map("updated_at")

    @@unique([userId, pushToken], map: "user_push_tokens_user_id_push_token_key")
    @@index([userId, isActive], map: "idx_user_push_tokens_active")
    @@index([userId], map: "idx_user_push_tokens_user_id")
    @@check(expression: sql`(device_type = ANY (ARRAY['ios'::text, 'android'::text]))`, map: "user_push_tokens_device_type_check")
    @@rls
    @@map("user_push_tokens")
  }

  model UserSettings {
    id        Uuid               @id(map: "user_settings_pkey") @default(sql`gen_random_uuid()`)
    userId    Uuid?              @unique(map: "user_settings_user_id_key") @map("user_id")
    darkMode  Boolean?           @default(false) @map("dark_mode")
    language  String?            @default("ko")
    createdAt TimestamptzString? @default(now()) @map("created_at")
    updatedAt TimestamptzString? @default(now()) @map("updated_at")
    user      Profiles?          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_settings_user_id_fkey")

    @@rls
    @@map("user_settings")
  }

